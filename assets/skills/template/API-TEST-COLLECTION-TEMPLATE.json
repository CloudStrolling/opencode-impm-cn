{
  "info": {
    "name": "{项目中文名称} 接口测试 v{当前版本号}",
    "description": "由 impm-task-coding-writetest 根据当前任务接口测试用例自动生成，符合 Postman Collection v2.1 规范，可供 API-TEST-RUNNER.py 执行接口测试，也可直接导入 Apifox 调试。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" }
  ],
  "auth_config": {
    "_comment": "可选认证配置：当接口需要登录态时填写，API-TEST-RUNNER.py 会自动处理登录并注入 token/cookie",
    "enabled": false,
    "login": {
      "_comment": "单步登录接口配置（与 steps 二选一）",
      "url": "{{base_url}}/api/auth/login",
      "method": "POST",
      "headers": { "Content-Type": "application/json" },
      "body": "{\"username\": \"{{username}}\", \"password\": \"{{password}}\"}",
      "token_path": "$.data.token",
      "token_type": "Bearer",
      "token_header": "Authorization",
      "cookie_name": "",
      "cookie_path": ""
    },
    "steps": [
      {
        "_comment": "多步登录配置示例：第一步获取 loginTicket，第二步用 loginTicket 换取 token",
        "name": "第一步：获取 loginTicket",
        "url": "{{base_url}}/api/auth/getLoginTicket",
        "method": "POST",
        "headers": { "Content-Type": "application/json" },
        "body": "{\"username\": \"{{username}}\", \"password\": \"{{password}}\"}",
        "token_path": "",
        "extract_vars": {
          "loginTicket": "$.data.loginTicket"
        }
      },
      {
        "name": "第二步：用 loginTicket 换取 token",
        "url": "{{base_url}}/api/auth/login",
        "method": "POST",
        "headers": { "Content-Type": "application/json" },
        "body": "{\"loginTicket\": \"{{loginTicket}}\"}",
        "token_path": "$.data.token",
        "token_type": "Bearer",
        "token_header": "Authorization",
        "extract_vars": {}
      }
    ],
    "credentials": {
      "_comment": "数据库查询配置：从数据库获取管理员账号密码",
      "source": "database",
      "db_type": "mysql",
      "db_host": "localhost",
      "db_port": 3306,
      "db_name": "",
      "db_user": "",
      "db_password": "",
      "query": "SELECT username, password FROM sys_user WHERE role='admin' AND status=1 LIMIT 1",
      "username_field": "username",
      "password_field": "password"
    }
  },
  "item": [
    {
      "name": "{接口路径} - {用例名称} ({用例ID})",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/example?id=1",
          "host": ["{{base_url}}"],
          "path": ["api", "example"],
          "query": [
            { "key": "id", "value": "1" }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"key\":\"value\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('状态码 200', function () { pm.response.to.have.status(200); });",
              "pm.test('业务码 code=0', function () { pm.expect(pm.response.json().code).to.eql(0); });"
            ]
          }
        }
      ],
      "expected": {
        "status": 200,
        "max_response_time": 2000,
        "headers": [
          { "name": "Content-Type", "contains": "application/json" }
        ],
        "assertions": [
          { "type": "json", "path": "$.code", "equals": 0 },
          { "type": "json", "path": "$.data.id", "contains": "预期子串" },
          { "type": "body_contains", "value": "预期出现的文本" }
        ]
      }
    }
  ]
}
